# TeamHub 環境變數設定範例
# 請複製此檔案並重新命名為 .env，填入您個人的雲端資料庫連線資訊

# 伺服器通訊埠 (Render 部署時會自動注入 process.env.PORT，本機預設 3000)
PORT=3000

# 運作環境 (development / production)
NODE_ENV=development

# 雲端 PostgreSQL 資料庫連線字串 (可由 Neon / Supabase / Render 後台取得)
# 格式範例: postgresql://username:password@hostname:5432/database_name?sslmode=require
DATABASE_URL=postgresql://postgres:your_password@ep-sample-pooler.us-east-2.neon.tech/teamhub_db?sslmode=require

# JWT 身分驗證安全密鑰 (請替換為隨機且複雜的長字串)
JWT_SECRET=teamhub_super_secret_jwt_key_change_in_production_2026

# JWT Token 有效期限 (例如: 7d 代表 7 天)
JWT_EXPIRES_IN=7d
